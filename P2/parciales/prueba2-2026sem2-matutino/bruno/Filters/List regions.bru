meta {
  name: List regions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/regions
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("vienen ordenadas alfabeticamente y sin repetir", function() {
    const body = res.getBody();
    expect(body).to.eql([...new Set(body)].sort());
  });

  test("son las 8 regiones del dataset", function() {
    expect(res.getBody()).to.eql([
      "Africa", "Americas", "Antarctic", "Antarctic Ocean",
      "Asia", "Europe", "Oceania", "Polar",
    ]);
  });
}

docs {
  Alimenta las opciones del filtro por region. Ojo que no son las 5 regiones
  clasicas: el dataset trae tambien `Antarctic`, `Antarctic Ocean` y `Polar`,
  con un solo pais cada una.

  El valor es el mismo string que viene en `region` de cada pais y el que va
  en la URL de la app: `/countries?region=Americas`.
}
